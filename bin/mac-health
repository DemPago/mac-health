#!/usr/bin/env bash
#
# mac-health — Check prestazioni Mac (RAM, swap, CPU, disco)
#
# Nessuna dipendenza esterna: usa solo tool nativi macOS
# (awk, sysctl, vm_stat, ps, df, memory_pressure, system_profiler).
#
# Exit codes:
#   0 = sistema in salute
#   1 = sistema sotto carico (warning)
#   2 = sistema in pressione critica
#
# Licenza: MIT

set -euo pipefail

VERSION="1.5.0"
PROG="mac-health"

export LC_ALL=C  # forza punto decimale, indipendente dalla locale

# ─────────────────────────────────────────────────────────────
# Opzioni / flag
# ─────────────────────────────────────────────────────────────
USE_COLOR=1
OUTPUT="text"   # text | json
FAST_MODE=0     # --fast: salta system_profiler (più veloce)
QUIET=0         # --quiet: nessun output, solo exit code
CLEAR_SCREEN=0  # default: 1 in terminale reale, 0 in pipe/CI/--no-clear
OUT_FILE=""     # --out FILE: salva report no-color su file (scripting)

# Disattiva colori e clear screen se l'output non è un terminale
[ -t 1 ] || USE_COLOR=0
[ -t 1 ] && CLEAR_SCREEN=1 || CLEAR_SCREEN=0

print_help() {
  cat <<EOF
${PROG} v${VERSION} — check rapido delle prestazioni del Mac

USO:
  ${PROG} [opzioni]

OPZIONI:
  -j, --json        Output in formato JSON (per script/automazioni)
      --no-color    Disabilita i colori
      --fast        Salta system_profiler (avvio più rapido, modello/chip non mostrati)
      --no-clear    Non pulire lo schermo prima del report
  -o, --out FILE    Salva il report su FILE (no colori, silenzioso)
  -q, --quiet       Nessun output: solo exit code (utile in CI/cron)
  -h, --help        Mostra questo aiuto
  -v, --version     Mostra la versione

SOGLIE CONFIGURABILI (variabili d'ambiente):
  MAC_HEALTH_SWAP_WARN   GB swap per livello warning  (default: 2)
  MAC_HEALTH_SWAP_CRIT   GB swap per livello critico  (default: 6)
  MAC_HEALTH_MEM_WARN    % memoria libera per warning (default: 40)
  MAC_HEALTH_MEM_CRIT    % memoria libera per critico (default: 20)
  MAC_HEALTH_LOAD_WARN   load/core per warning        (default: 1.5)

EXIT CODES:
  0  sistema in salute
  1  sistema sotto carico (warning)
  2  sistema in pressione critica

ESEMPI:
  ${PROG}                       # report leggibile a colori
  ${PROG} --json                # output JSON
  ${PROG} --fast --json         # JSON senza system_profiler
  ${PROG} >> ~/mac-health.log   # salva storico (colori off automatico)
  MAC_HEALTH_SWAP_CRIT=4 ${PROG}  # soglia critica swap a 4 GB
EOF
}

while [ $# -gt 0 ]; do
  case "$1" in
    -j|--json)     OUTPUT="json" ;;
    --no-color)    USE_COLOR=0 ;;
    --fast)        FAST_MODE=1 ;;
    --no-clear)    CLEAR_SCREEN=0 ;;
    -o|--out)
      [ $# -gt 1 ] || { echo "Opzione $1 richiede un argomento." >&2; exit 64; }
      OUT_FILE="$2"; shift ;;
    -q|--quiet)    QUIET=1 ;;
    -h|--help)     print_help; exit 0 ;;
    -v|--version)  echo "${PROG} v${VERSION}"; exit 0 ;;
    *) echo "Opzione sconosciuta: $1" >&2; echo "Usa '${PROG} --help'." >&2; exit 64 ;;
  esac
  shift
done

# ─────────────────────────────────────────────────────────────
# Soglie (sovrascrivibili via env)
# ─────────────────────────────────────────────────────────────
SWAP_WARN=${MAC_HEALTH_SWAP_WARN:-2}
SWAP_CRIT=${MAC_HEALTH_SWAP_CRIT:-6}
MEM_WARN=${MAC_HEALTH_MEM_WARN:-40}
MEM_CRIT=${MAC_HEALTH_MEM_CRIT:-20}
LOAD_WARN=${MAC_HEALTH_LOAD_WARN:-1.5}

# ─────────────────────────────────────────────────────────────
# Colori (attivi solo se USE_COLOR=1)
# ─────────────────────────────────────────────────────────────
if [ "$USE_COLOR" -eq 1 ]; then
  RED=$'\033[0;31m'; GRN=$'\033[0;32m'; YEL=$'\033[1;33m'
  BLU=$'\033[1;34m'; BLD=$'\033[1m'; NC=$'\033[0m'
else
  RED=; GRN=; YEL=; BLU=; BLD=; NC=
fi

hr() { printf "%s%s%s\n" "$BLU" "────────────────────────────────────────────" "$NC"; }

# Escape per stringhe JSON: \, ", newline, tab
json_str() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\r'/\\r}"
  s="${s//$'\t'/\\t}"
  printf '"%s"' "$s"
}

# Salva il report no-color su file rieseguendo lo script
_save_report() {
  local dest="$1"
  local extra_args=(--no-color)
  [ "$FAST_MODE" -eq 1 ] && extra_args+=(--fast)
  "${BASH_SOURCE[0]}" "${extra_args[@]}" > "$dest" 2>&1 || true
}

# ─────────────────────────────────────────────────────────────
# Raccolta dati (una sola volta ciascuno)
# ─────────────────────────────────────────────────────────────
if [ "$FAST_MODE" -eq 0 ]; then
  HW=$(system_profiler SPHardwareDataType 2>/dev/null || true)
  MODEL=$(printf '%s\n' "$HW" | awk -F': ' '/Model Name/{print $2; exit}')
  CHIP=$(printf '%s\n' "$HW" | awk -F': ' '/Chip|Processor Name/{print $2; exit}')
  BATT_RAW=$(system_profiler SPPowerDataType 2>/dev/null || true)
else
  MODEL=""
  CHIP=""
  BATT_RAW=""
fi
[ -z "$MODEL" ] && MODEL="Mac"
[ -z "$CHIP" ]  && CHIP="CPU sconosciuta"

RAM_GB=$(( $(sysctl -n hw.memsize) / 1024 / 1024 / 1024 ))
CORES=$(sysctl -n hw.ncpu)
read -r LOAD1 LOAD5 LOAD15 < <(sysctl -n vm.loadavg | awk '{print $2, $3, $4}')
UP=$(uptime | sed -E 's/.*up ([^,]*(, [0-9]+ [a-z]+)?),.*/\1/')

# Protegge da errori di memory_pressure senza far uscire lo script con set -e
FREE_PCT=$( { memory_pressure 2>/dev/null || true; } | awk -F': ' '/percentage/{gsub(/%/,"",$2); print $2+0; exit}')
[ -z "$FREE_PCT" ] && FREE_PCT=-1

VMSTAT=$(vm_stat)
PGSIZE=$(printf '%s\n' "$VMSTAT" | awk 'NR==1{match($0,/[0-9]+/); print substr($0,RSTART,RLENGTH); exit}')
COMP_GB=$(printf '%s\n' "$VMSTAT" | awk -v pg="$PGSIZE" '/occupied by compressor/{gsub(/\./,"",$5); printf "%.1f", $5*pg/1073741824}')
[ -z "$COMP_GB" ] && COMP_GB="0.0"

# Gestisce unità M/G/K nel campo swap (es. "2158.00M" o "2.16G")
SWAP_GB=$(sysctl -n vm.swapusage | awk '{
  for(i=1;i<=NF;i++) if($i=="used"){
    raw=$(i+2)
    val=raw; gsub(/[^0-9.]/,"",val)
    unit=raw; gsub(/[0-9.]/,"",unit)
    if (unit~/[Gg]/) printf "%.1f", val+0
    else if (unit~/[Kk]/) printf "%.1f", val/1048576
    else printf "%.1f", val/1024
    exit
  }
}')
[ -z "$SWAP_GB" ] && SWAP_GB="0.0"

# ── Batteria (vuoto sui desktop — section saltata in output) ──
BATT_CONDITION=$(printf '%s\n' "$BATT_RAW" | awk -F': ' '/Condition/{gsub(/^[ \t]+/,"",$2); print $2; exit}')
BATT_CYCLES=$(printf '%s\n' "$BATT_RAW" | awk -F': ' '/Cycle Count/{gsub(/^[ \t]+/,"",$2); print $2+0; exit}')
BATT_CAPACITY=$(printf '%s\n' "$BATT_RAW" | awk -F': ' '/Maximum Capacity/{gsub(/[^0-9]/,"",$2); print $2+0; exit}')

# ── Stato SMART disco principale ──
SMART=$(diskutil info disk0 2>/dev/null | awk -F': ' '/SMART Status/{gsub(/^[ \t]+/,"",$2); print $2; exit}' || true)
[ -z "$SMART" ] && SMART="n/d"

# ── Thermal throttling ──
THERM_RAW=$(pmset -g therm 2>/dev/null || true)
THERM_STATE=$(printf '%s\n' "$THERM_RAW" | awk '/System wide thermal state/{print $NF; exit}')
THERM_SPEED=$(printf '%s\n' "$THERM_RAW" | awk '/CPU_Speed_Limit/{print $NF; exit}')
[ -z "$THERM_STATE" ] && THERM_STATE="No"

read -r DISK_TOTAL_KB DISK_FREE_KB DISK_USED < <(df -k / | awk 'NR==2{print $2, $4, $5}')
DISK_FREE=$(awk -v k="$DISK_FREE_KB" 'BEGIN{
  gb = k / 1048576
  if (gb >= 1) printf "%.0f GB", gb
  else printf "%d MB", int(k/1024)
}')
DISK_TOTAL=$(awk -v k="$DISK_TOTAL_KB" 'BEGIN{
  gb = k / 1048576
  if (gb >= 1) printf "%.0f GB", gb
  else printf "%d MB", int(k/1024)
}')

# Livelli di stato (usa soglie configurabili)
MEM_LEVEL=$(awk -v f="$FREE_PCT" -v warn="$MEM_WARN" -v crit="$MEM_CRIT" '
  BEGIN{ if(f<0)print "na"; else if(f>=warn)print "ok"; else if(f>=crit)print "warn"; else print "high" }')
SWAP_LEVEL=$(awk -v s="$SWAP_GB" -v warn="$SWAP_WARN" -v crit="$SWAP_CRIT" '
  BEGIN{ if(s<warn)print "ok"; else if(s<crit)print "warn"; else print "high" }')

SMART_FAIL=0;    [ "$SMART" = "Failing" ] && SMART_FAIL=1
THERM_THROTTLE=0; [ "$THERM_STATE" = "Yes" ] && THERM_THROTTLE=1

# Verdetto complessivo → exit code
VERDICT=$(awk -v s="$SWAP_GB" -v f="$FREE_PCT" -v l="$LOAD1" -v c="$CORES" \
              -v sw="$SWAP_WARN" -v sc="$SWAP_CRIT" \
              -v mw="$MEM_WARN" -v mc="$MEM_CRIT" \
              -v lw="$LOAD_WARN" \
              -v sf="$SMART_FAIL" -v tt="$THERM_THROTTLE" 'BEGIN{
  load_norm = (c > 0) ? l/c : 0
  if ((s>=sc) || (f>=0 && f<mc) || sf==1) print "red"
  else if ((s>=sw) || (f>=0 && f<mw) || load_norm > lw || tt==1) print "yellow"
  else print "green"
}')

# ─────────────────────────────────────────────────────────────
# Top processi (funzioni riusabili)
# ─────────────────────────────────────────────────────────────
top_cpu() {
  # $1 = pcpu; resto della riga = nome completo del processo (gestisce spazi)
  ps -Ao pcpu,comm -r | awk 'NR>1 && NR<=6{
    cpu=$1; $1=""; sub(/^ /,""); n=$0
    split(n,a,"/"); print cpu, a[length(a)]
  }'
}

top_ram() {
  ps -Ao rss,comm | awk '
  NR>1 {
    rss=$1; $1=""; sub(/^ /,""); path=$0
    if (index(path, ".app/") > 0) {
      tmp=path; sub(/\.app\/.*$/,"",tmp); sub(/^.*\//,"",tmp); key=tmp
    } else { split(path,a,"/"); key=a[length(a)] }
    s[key]+=rss; c[key]++
  }
  END { for (k in s) printf "%.0f\t%d\t%s\n", s[k]/1024, c[k], k }
  ' | sort -rn | head -6
}

# ─────────────────────────────────────────────────────────────
# Output JSON
# ─────────────────────────────────────────────────────────────
if [ "$QUIET" -eq 1 ] && [ "$OUTPUT" != "json" ]; then
  : # nessun output: cade direttamente all'exit code finale
elif [ "$OUTPUT" = "json" ]; then
  MODEL_JSON=$(json_str "$MODEL")
  CHIP_JSON=$(json_str "$CHIP")
  DISK_FREE_JSON=$(json_str "$DISK_FREE")
  DISK_USED_JSON=$(json_str "$DISK_USED")

  # Nomi completi e escapati in JSON
  cpu_json=$(top_cpu | awk '
    function je(s) { gsub(/\\/, "\\\\", s); gsub(/"/, "\\\"", s); return s }
    BEGIN{first=1; printf "["}
    { cpu=$1; $1=""; sub(/^ /,""); name=$0
      if(!first)printf ","; first=0
      printf "{\"cpu\":%s,\"name\":\"%s\"}",cpu,je(name) }
    END{printf "]"}')

  ram_json=$(top_ram | awk -F'\t' '
    function je(s) { gsub(/\\/, "\\\\", s); gsub(/"/, "\\\"", s); return s }
    BEGIN{first=1; printf "["}
    { if(!first)printf ","; first=0
      printf "{\"mb\":%s,\"procs\":%s,\"name\":\"%s\"}",$1,$2,je($3) }
    END{printf "]"}')

  cat <<EOF
{
  "version": "${VERSION}",
  "model": ${MODEL_JSON},
  "chip": ${CHIP_JSON},
  "ram_gb": ${RAM_GB},
  "cores": ${CORES},
  "load": ${LOAD1},
  "load_5m": ${LOAD5},
  "load_15m": ${LOAD15},
  "memory_free_pct": ${FREE_PCT},
  "memory_compressed_gb": ${COMP_GB},
  "swap_used_gb": ${SWAP_GB},
  "disk_total": $(json_str "$DISK_TOTAL"),
  "disk_free": ${DISK_FREE_JSON},
  "disk_used_pct": ${DISK_USED_JSON},
  "smart_status": $(json_str "$SMART"),
  "thermal_throttle": $([ "$THERM_THROTTLE" -eq 1 ] && echo "true" || echo "false"),
  "thermal_cpu_speed_pct": $([ -n "$THERM_SPEED" ] && echo "$THERM_SPEED" || echo "null"),
  "battery": $([ -n "$BATT_CONDITION" ] && printf '{"condition":%s,"cycles":%s,"max_capacity_pct":%s}' "$(json_str "$BATT_CONDITION")" "${BATT_CYCLES:-null}" "${BATT_CAPACITY:-null}" || echo "null"),
  "verdict": "${VERDICT}",
  "top_cpu": ${cpu_json},
  "top_ram": ${ram_json}
}
EOF
else
  # ── Output testuale ──
  [ "$CLEAR_SCREEN" -eq 1 ] && printf '\033[2J\033[H'
  echo ""
  printf "%s  MAC HEALTH CHECK  —  %s%s\n" "$BLD" "$(date '+%d/%m/%Y %H:%M')" "$NC"
  hr
  printf "%sMacchina:%s %s | %s | %s%s GB RAM%s\n" "$BLD" "$NC" "$MODEL" "$CHIP" "$BLD" "$RAM_GB" "$NC"
  printf "%sAcceso da:%s %s\n" "$BLD" "$NC" "$UP"
  printf "%sCarico CPU:%s %s / %s / %s  su %s core  (1/5/15 min)\n" "$BLD" "$NC" "$LOAD1" "$LOAD5" "$LOAD15" "$CORES"
  hr

  printf "%sMemoria libera:%s " "$BLD" "$NC"
  case "$MEM_LEVEL" in
    na)   printf "n/d\n" ;;
    ok)   printf "%s%s%%  (buono)%s\n" "$GRN" "$FREE_PCT" "$NC" ;;
    warn) printf "%s%s%%  (sotto pressione)%s\n" "$YEL" "$FREE_PCT" "$NC" ;;
    high) printf "%s%s%%  (critico)%s\n" "$RED" "$FREE_PCT" "$NC" ;;
  esac
  printf "%sMemoria compressa:%s %s GB\n" "$BLD" "$NC" "$COMP_GB"

  printf "%sSwap usato:%s " "$BLD" "$NC"
  case "$SWAP_LEVEL" in
    ok)   printf "%s%s GB  (ok)%s\n" "$GRN" "$SWAP_GB" "$NC" ;;
    warn) printf "%s%s GB  (attenzione)%s\n" "$YEL" "$SWAP_GB" "$NC" ;;
    high) printf "%s%s GB  (alto → causa lentezza)%s\n" "$RED" "$SWAP_GB" "$NC" ;;
  esac
  hr

  printf "%sTop 5 processi per CPU:%s\n" "$BLD" "$NC"
  top_cpu | awk '{pct=$1; $1=""; sub(/^ /,""); printf "  %5s%%  %s\n",pct,$0}'
  hr

  printf "%sTop 6 app per RAM:%s\n" "$BLD" "$NC"
  top_ram | awk -F'\t' '{printf "  %6s MB  (%2s proc)  %s\n",$1,$2,$3}'
  printf "  %s(valori RSS: le pagine condivise tra processi vengono conteggiate più volte)%s\n" "$BLU" "$NC"
  hr

  printf "%sDisco:%s %s liberi su %s  (usato %s)\n" "$BLD" "$NC" "$DISK_FREE" "$DISK_TOTAL" "$DISK_USED"

  printf "%sSMART disco:%s " "$BLD" "$NC"
  case "$SMART" in
    Verified) printf "%sVerified%s\n" "$GRN" "$NC" ;;
    Failing)  printf "%sFailing — fai subito un backup!%s\n" "$RED" "$NC" ;;
    *)        printf "%s\n" "$SMART" ;;
  esac

  printf "%sTermico:%s " "$BLD" "$NC"
  if [ "$THERM_STATE" = "Yes" ] && [ -n "$THERM_SPEED" ]; then
    printf "%sThrottling — CPU limitata al %s%%%s\n" "$YEL" "$THERM_SPEED" "$NC"
  elif [ "$THERM_STATE" = "No" ]; then
    printf "%sok%s\n" "$GRN" "$NC"
  else
    printf "n/d\n"
  fi

  if [ "$FAST_MODE" -eq 1 ]; then
    printf "%sBatteria:%s n/d  (usa mac-health senza --fast)\n" "$BLD" "$NC"
  elif [ -n "$BATT_CONDITION" ]; then
    _batt_col="$GRN"
    [[ "$BATT_CONDITION" == *"Replace"* ]] && _batt_col="$YEL"
    [[ "$BATT_CONDITION" == *"Service"* ]] && _batt_col="$RED"
    printf "%sBatteria:%s %s%s%s" "$BLD" "$NC" "$_batt_col" "$BATT_CONDITION" "$NC"
    if [ -n "$BATT_CYCLES" ] || [ -n "$BATT_CAPACITY" ]; then
      printf "  ("
      [ -n "$BATT_CYCLES" ]   && printf "%s cicli" "$BATT_CYCLES"
      [ -n "$BATT_CYCLES" ] && [ -n "$BATT_CAPACITY" ] && printf ", "
      [ -n "$BATT_CAPACITY" ] && printf "capacità %s%%" "$BATT_CAPACITY"
      printf ")"
    fi
    printf "\n"
  fi
  hr

  printf "%sVerdetto:%s " "$BLD" "$NC"
  case "$VERDICT" in
    red)    printf "%sRAM sotto forte pressione. Chiudi app pesanti (browser!) o riavvia.%s\n" "$RED" "$NC" ;;
    yellow) printf "%sSituazione gestibile ma sotto carico. Occhio ai browser.%s\n" "$YEL" "$NC" ;;
    green)  printf "%sSistema in salute.%s\n" "$GRN" "$NC" ;;
  esac
  echo ""

  # ── Salvataggio report ──
  # Se --out è stato passato, salva direttamente senza chiedere
  if [ -n "$OUT_FILE" ]; then
    _save_report "$OUT_FILE"
  # Prompt interattivo solo se siamo in un vero terminale (non pipe/CI)
  elif [ -t 0 ] && [ -t 1 ]; then
    printf "%sSalvare il report su file?%s [s/N] " "$BLD" "$NC"
    read -r _answer < /dev/tty || true
    if [[ "$_answer" =~ ^[sS]$ ]]; then
      _dest="$HOME/Desktop/mac-health-$(date '+%Y%m%d-%H%M').txt"
      [ ! -d "$HOME/Desktop" ] && _dest="$HOME/mac-health-$(date '+%Y%m%d-%H%M').txt"
      _save_report "$_dest"
      printf "%sReport salvato:%s %s\n\n" "$GRN" "$NC" "$_dest"
      open -R "$_dest"
    fi
  fi
fi

# ─────────────────────────────────────────────────────────────
# Exit code in base al verdetto
# ─────────────────────────────────────────────────────────────
case "$VERDICT" in
  red)    exit 2 ;;
  yellow) exit 1 ;;
  *)      exit 0 ;;
esac
